# BBox Studio configuration
# Each *_load flag: true = apply on startup, false = ignore that group

# Font (right-click Font…)
font_load=true
font_family=Segoe UI
font_size=12

# Colors (right-click Color…) + brand visibility
color_load=true
copy_bg=#7c9cff
copy_hi=#9db4ff
copy_fg=#0f0f17
chip_bg=#1a3330
chip_border=#3d8f7c
chip_fg=#b8e8dc
delete_bg=#f87171
delete_hi=#fca5a5
delete_fg=#0f0f17
brand_fg=#7c9cff
menu_highlight=#cbcbdc
menu_divider=#8b8ba0
grip_hover=#7c9cff
show_brand=true
show_logo=true

# Window size / maximized state
window_load=true
window_state=normal
window_width=1320
window_height=860
window_x=
window_y=

# Snap to grid
snap_load=true
snap_to_grid=false

# Canvas grid style
grid_load=true
grid_style=default

# Canvas resolution
resolution_load=true
canvas_width=1024
canvas_height=1024

# Right-panel text area heights (rows)
grip_caption_h=3
grip_item_caption_h=3
grip_item_text_h=2
